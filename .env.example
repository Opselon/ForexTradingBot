# ============================================
# ForexTradingBot - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to git!
#
# Values are intentionally left EMPTY here: every "example" string below a
# credential key tends to trip secret scanners. The commented lines show the
# format; paste your real values on the uncommented lines after copying.

# ============================================
# Telegram Bot Configuration
# ============================================
# From @BotFather:
#   TELEGRAM_BOT_TOKEN=<paste your bot token>
TELEGRAM_BOT_TOKEN=

# Public HTTPS endpoint where Telegram sends updates:
#   TELEGRAM_WEBHOOK_ADDRESS=https://your.domain/
TELEGRAM_WEBHOOK_ADDRESS=

# Shared secret used to sign Telegram webhook payloads:
#   TELEGRAM_WEBHOOK_SECRET=<choose a long random string>
TELEGRAM_WEBHOOK_SECRET=

# Telegram User API (if you need user-level Telegram access)
#   TELEGRAM_API_ID=<numeric api id>
#   TELEGRAM_API_HASH=<api hash>
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=

# Admin user IDs (comma-separated Telegram user IDs allowed to control the bot)
ADMIN_USER_IDS=

# ============================================
# PostgreSQL Database Configuration
# ============================================
#   POSTGRES_PASSWORD=<choose a strong password>
POSTGRES_PASSWORD=

# ============================================
# Crypto Pay Configuration
# ============================================
#   CRYPTO_PAY_API_TOKEN=<paste your api token>
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_BASE_URL=https://pay.crypt.bot/api/
CRYPTO_PAY_IS_TESTNET=true

#   CRYPTO_PAY_WEBHOOK_SECRET=<choose a long random string>
CRYPTO_PAY_WEBHOOK_SECRET=

# ============================================
# Forwarding Rules (Optional)
# ============================================
# Format example (uncomment and fill in):
#   FORWARDING_RULES__0__BotToken=<paste forwarding bot token>
#   FORWARDING_RULES__0__SourceChannelId=-1001234567890
#   FORWARDING_RULES__0__TargetChannelId=-1009876543210
#   FORWARDING_RULES__0__IsEnabled=true

# ============================================
# Development Settings (Do NOT use in Production)
# ============================================
ASPNETCORE_ENVIRONMENT=Development
Logging__LogLevel__Default=Debug
Logging__LogLevel__Microsoft=Warning
