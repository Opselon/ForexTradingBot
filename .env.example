# ============================================
# ForexTradingBot - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env file to git!

# ============================================
# Telegram Bot Configuration
# ============================================
# Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_ADDRESS=your_webhook_url_here
TELEGRAM_WEBHOOK_SECRET=your_secret_for_webhooks

# Telegram User API (if you need user-level Telegram access)
TELEGRAM_API_ID=111111  # Replace with your actual API ID
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_NUMBER=+989XXXXXXXXX  # Replace with your phone number

# Admin User IDs (comma-separated list of Telegram user IDs who can control the bot)
ADMIN_USER_IDS="[537833]"

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_PASSWORD=change_this_to_a_strong_password_123!@#
# Note: This is used for both main DB and backup database

# ============================================
# Crypto Pay Configuration
# ============================================
CRYPTO_PAY_API_TOKEN=your_crypto_pay_api_token_here
CRYPTO_PAY_BASE_URL=https://pay.crypt.bot/api/
CRYPTO_PAY_IS_TESTNET=true
CRYPTO_PAY_WEBHOOK_SECRET=your_webhook_secret_for_crypto_pay

# ============================================
# Forwarding Rules (Optional)
# ============================================
# Add forwarding rules here if needed:
# FORWARDING_RULES__0__BotToken=forwarding_bot_token
# FORWARDING_RULES__0__SourceChannelId=-100xxxxxxxxx
# FORWARDING_RULES__0__TargetChannelId=-100xxxxxxxxx
# FORWARDING_RULES__0__IsEnabled=true

# ============================================
# Development Settings (Do NOT use in Production)
# ============================================
ASPNETCORE_ENVIRONMENT=Development
Logging__LogLevel__Default=Debug
Logging__LogLevel__Microsoft=Warning
